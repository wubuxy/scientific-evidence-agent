# Copy to .env.research and generate your own secret. Do not commit credentials.
JWT_SECRET_KEY=
RESEARCH_DATA_DIR=.research-data

# Optional: model calls are needed only for research runs.
# DASHSCOPE_API_KEY from the existing environment is also supported.
RESEARCH_LLM_API_KEY=
RESEARCH_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RESEARCH_LLM_MODEL=qwen3.5-27b
# Optional JSON request extensions for the selected inference server.
# vLLM Qwen3 example: {"chat_template_kwargs":{"enable_thinking":false}}
# DashScope example (only if the requested model is available): {"enable_thinking":false}
RESEARCH_LLM_EXTRA_BODY={"enable_thinking":false}

# Optional public web search; scholarly metadata search uses arXiv.
SERPER_API_KEY=
BOCHA_API_KEY=
RESEARCH_WEB_PROVIDER=auto

# Local hybrid retrieval uses BM25 + embedding API; no Milvus service is needed.
RESEARCH_RAG_ENABLED=false
RESEARCH_RAG_BACKEND=local
RESEARCH_EMBEDDING_MODEL=text-embedding-v4
RESEARCH_RAG_COLLECTION=research_sources_v1

# Optional absolute path if rg is not on PATH. Otherwise literal Python fallback
# is reported explicitly as python_literal.
RESEARCH_RG_BINARY=
